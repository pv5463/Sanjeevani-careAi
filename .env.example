# ==================================================
# SANJEEVANI CareAI — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ==================================================

# --- App ---
NODE_ENV=development
APP_NAME="SANJEEVANI CareAI"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DEMO_MODE=true

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/sanjeevani?retryWrites=true&w=majority

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=change-me-session-secret

# --- Supabase Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=medical-documents

# Next.js public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- AI Provider ---
AI_PROVIDER=gemini
# Options: gemini | openai | mock
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- Speech ---
STT_PROVIDER=web-speech
# Options: web-speech | bhashini | azure | google-cloud
TTS_PROVIDER=web-speech

# Bhashini (Indian language STT/TTS — optional)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- OCR ---
OCR_PROVIDER=tesseract
# Options: tesseract | google-document-ai | azure-form-recognizer

# Google Document AI (optional, for production)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- FHIR / ABDM ---
# Set ABDM_MODE=mock for SIH demo
ABDM_MODE=mock
FHIR_BASE_URL=https://your-fhir-server.com/fhir
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# --- HIS (Hospital Information System) ---
HIS_BASE_URL=
HIS_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- File Upload ---
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# --- Notifications (Optional SMS/Email) ---
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Demo Credentials ---
DEMO_DOCTOR_EMAIL=doctor@sanjeevani.in
DEMO_DOCTOR_PASSWORD=demo1234
DEMO_ADMIN_EMAIL=admin@sanjeevani.in
DEMO_ADMIN_PASSWORD=admin1234
DEMO_HOSPITAL_NAME="AIIMS Demo Hospital"
